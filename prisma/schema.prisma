// Pocket Ledger database schema.
// Runs on SQLite locally; written to stay portable to PostgreSQL (Phase 8).
// Rule: every table holding a user's data has a `userId` column and must be
// listed in USER_OWNED_MODELS (src/lib/db/scoped.ts). A test enforces this.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  USER
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String?   @unique
  name             String
  passwordHash     String
  pinHash          String?
  role             Role      @default(USER)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Per-user settings
  autoLockMinutes Int    @default(10)
  currency        String @default("LKR")
  timezone        String @default("Asia/Colombo")
  // Purchases at or above this (in cents) default to "record as asset". Rs 50,000.
  assetThresholdCents Int @default(5000000)
  // "Late income shift": income on/after this day of the month counts toward next month (null = off).
  lateIncomeDay       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  invitesCreated Invite[]    @relation("InviteCreatedBy")
  inviteUsed     Invite?     @relation("InviteUsedBy")
  auditLogs      AuditLog[]
  accounts       Account[]
  entries        Entry[]
  entryLines     EntryLine[]
  fixedAssets    FixedAsset[]
  loans          Loan[]
  debts          Debt[]
  importBatches  ImportBatch[]
  importRows     ImportRow[]
}

// ---- Ledger (double-entry) ---------------------------------------------------

enum AccountType {
  ASSET // things you own: cash, bank, savings (later: assets, money lent)
  LIABILITY // money you owe (Phase 4)
  INCOME // income categories
  EXPENSE // expense categories
  EQUITY // opening balances
}

// An "account" is anything money can sit in or flow through, including
// income and expense categories.
model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  subtype   String? // ASSET: CASH | BANK | SAVINGS | OTHER | FIXED | LENT · LIABILITY: CARD | LOAN
  isSystem  Boolean     @default(false) // created and managed by the app (e.g. Opening Balances)
  systemKey String? // which app-managed account: OPENING | DEPRECIATION | ASSET_GAIN | ASSET_LOSS | BAD_DEBTS
  archived  Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines      EntryLine[]
  fixedAsset FixedAsset?
  loan       Loan?
  debt       Debt?

  @@index([userId, type])
}

enum EntryKind {
  OPENING_BALANCE
  INCOME
  EXPENSE
  TRANSFER
  ASSET_PURCHASE
  DEPRECIATION
  ASSET_REVALUATION
  ASSET_SALE
  LEND // money lent / invested (optionally with interest kept up front)
  LOAN_RETURN // money received back: principal + any interest
  LOAN_WRITE_OFF // money that isn't coming back
  BORROW // money borrowed (optionally with fees deducted)
  DEBT_PAYMENT // payment on a card / loan: principal + any interest
  DEBT_CHARGE // interest or fees added to a card / loan
}

// Credit cards & loans you owe. "Owed" is the balance of its own liability account.
model Debt {
  id              String  @id @default(cuid())
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String  @unique
  account         Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  name            String // e.g. "Sampath Visa", "Car loan"
  lender          String?
  kind            String // CREDIT_CARD | PAWNING | BANK_LOAN | LEASE | OTHER
  startDate       String // "YYYY-MM-DD"
  endDate         String?
  rateBasisPoints Int     @default(0) // 28% = 2800
  ratePeriod      String  @default("YEAR") // MONTH | YEAR
  creditLimit     BigInt? // cards (cents)
  dueDay          Int? // day of the month a payment is due (1–31)
  monthlyPayment  BigInt? // loan instalment (cents)
  status          String  @default("ACTIVE") // ACTIVE | PAID_OFF
  closedDate      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries Entry[]

  @@index([userId, status])
}

// Lending & investments register: one row per loan / cheque exchange / deposit.
// "Still out" is the balance of its own ledger account.
model Loan {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String  @unique
  account           Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  counterparty      String // who has the money: a person, bank or company
  kind              String // CHEQUE_EXCHANGE | PERSONAL_LOAN | FIXED_DEPOSIT | OTHER
  startDate         String // "YYYY-MM-DD"
  dueDate           String?
  rateBasisPoints   Int     @default(0) // 4% = 400 (no floating point)
  ratePeriod        String  @default("MONTH") // MONTH | YEAR
  interestAccountId String? // income category used for this loan's interest by default
  status            String  @default("ACTIVE") // ACTIVE | REPAID | WRITTEN_OFF
  closedDate        String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries Entry[]

  @@index([userId, status])
}

// Asset register: one row per thing you own (bike, phone, laptop…).
// Its current value is the balance of its own ledger account.
model FixedAsset {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String  @unique
  account          Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  name             String
  assetClass       String // VEHICLES | ELECTRONICS | COMPUTERS | FURNITURE | OTHER
  purchaseDate     String // "YYYY-MM-DD"
  cost             BigInt // cents
  residualValue    BigInt  @default(0) // value left at the end of its life (cents)
  usefulLifeMonths Int // 0 = doesn't lose value
  method           String  @default("STRAIGHT_LINE")
  status           String  @default("ACTIVE") // ACTIVE | SOLD | DISPOSED
  disposedDate     String?
  notes            String?
  photoPath        String? // file name inside the uploads folder
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries Entry[]

  @@index([userId, status])
}

// One transaction as the person sees it ("Paid Rs 5,000 for groceries").
model Entry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EntryKind
  date      String // calendar date "YYYY-MM-DD" (no time zone surprises)
  details   String?
  // Link to an asset: its purchase, depreciation, value change, sale, or a repair.
  assetId   String?
  asset     FixedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  // Link to a loan/investment: lending, money back, interest, write-off.
  loanId    String?
  loan      Loan?       @relation(fields: [loanId], references: [id], onDelete: SetNull)
  // Link to a card / loan you owe: starting balance, borrowing, payment, charge.
  debtId    String?
  debt      Debt?       @relation(fields: [debtId], references: [id], onDelete: SetNull)
  // The spreadsheet row this transaction was imported from (kept for audit).
  importRowId String?    @unique
  importRow   ImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  depMonth  String? // "YYYY-MM" for depreciation entries (stops double-posting)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lines EntryLine[]

  @@unique([assetId, depMonth])
  @@index([userId, date])
}

// The two (or more) sides of an Entry. Amounts are whole cents:
// positive = money flowing INTO the account, negative = flowing OUT
// (accountants call these debit and credit). Lines of an entry always sum to 0.
model EntryLine {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String
  entry     Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount    BigInt

  @@index([entryId])
  @@index([userId, accountId])
}

// One row per user per device ("remembered login"). The device can be
// quick-unlocked with a PIN while the session is alive.
model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash     String
  tokenHash      String   @unique
  locked         Boolean  @default(false)
  pinFailedCount Int      @default(0)
  lastActiveAt   DateTime @default(now())
  expiresAt      DateTime
  userAgent      String?
  createdAt      DateTime @default(now())

  @@unique([deviceHash, userId])
  @@index([deviceHash])
}

model Invite {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  note        String?
  email       String?
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Used for rate limiting sign-in / registration attempts by IP address.
model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  kind       String // "login" | "unlock" | "register"
  identifier String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([ip, kind, createdAt])
}

// Per-user activity log (security events now; data changes in later phases).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- Excel import -------------------------------------------------------------

// One uploaded spreadsheet. Rows are staged (nothing posted) until you post them.
model ImportBatch {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  status           String   @default("STAGED") // STAGED | POSTED | UNDONE
  accountId        String? // the money account the sheet tracked
  startingBalance  BigInt? // cents, posted as an opening balance
  startingDate     String?
  openingEntryId   String? // the opening-balance entry this import created
  mapping          String   @default("{}") // JSON: "Type / Category" → target
  lateIncomeDay    Int? // read from the sheet's Settings
  postedAt         DateTime?
  createdAt        DateTime @default(now())

  rows ImportRow[]

  @@index([userId, createdAt])
}

// One spreadsheet row, exactly as read, plus what it will become.
model ImportRow {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId     String
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int // row number in the sheet
  fingerprint String // same row in a later upload → same fingerprint (no duplicates)
  raw         String // JSON of the original cells
  date        String?
  type        String // Income | Expenses | Savings | ...
  category    String
  amount      BigInt? // cents
  details     String?
  // What to do: EXPENSE | INCOME | TRANSFER | ASSET | DEBT_PAYMENT | SKIP | REVIEW
  action      String  @default("REVIEW")
  targetId    String? // category / savings account / debt, depending on action
  manual      Boolean @default(false) // changed by hand (mapping changes won't override it)
  assetName   String?
  assetClass  String?
  lifeMonths  Int?
  loanId      String? // cheque-exchange interest linked to a loan
  note        String? // why it needs attention
  duplicate   Boolean @default(false) // already imported in an earlier batch

  entry Entry?

  @@index([batchId, rowNumber])
  @@index([userId, fingerprint])
}
