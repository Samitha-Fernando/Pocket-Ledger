# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ---- Pocket Ledger: private data, NEVER commit ----
# keep the example env file
!.env.example
# databases (real, demo and test)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
# uploads, backups, exports
/uploads/
/backups/
/exports/
# spreadsheets (your real budget file must never be committed)
*.xlsx
*.xls
*.xlsm
*.csv
# generated Prisma client
/src/generated/
# design-sync (Claude Design) build output and machine state
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
